# .env.example
# Copiar como .env para desarrollo local, o cargar estas mismas
# variables en AWS (App Runner / ECS / Elastic Beanstalk) como
# variables de entorno del servicio -- NUNCA subir un .env real con
# valores reales al repositorio.

# Cadena de conexion a Postgres (AWS RDS la entrega en este formato)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base

# Clave que firma las cookies de sesion -- generar una aleatoria larga,
# nunca reusar la de otro proyecto.
DASHBOARD_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Puerto e interfaz donde escucha el dashboard (server.py)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Cuantos dias hacia atras se conserva el detalle linea por linea
# (facturacion_detalle). El agregado mensual siempre conserva TODO
# el historico, independientemente de este valor.
VENTANA_DETALLE_DIAS=730

# SMTP para el mail diario
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=reportes@johnsonacero.com
